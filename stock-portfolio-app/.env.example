# Database Configuration
DB_NAME=name
DB_USER=user
DB_PASSWORD=password
DB_ROOT_PASSWORD=rootpass

# Prisma Database URL (for MySQL)
#
# ローカル（docker-compose の MySQL）
DATABASE_URL="mysql://user:pass@localhost:3306/stock_portfolio"
#
# 本番（TiDB Cloud Starter / ADR 0013）
# TiDB Cloud のコンソールが出す接続文字列をそのまま貼る。パブリックエンドポイントで
# 接続する場合は TLS が必須で、sslaccept=strict を付けないと接続できない。
# DATABASE_URL="mysql://xxxxx.root:PASSWORD@gateway01.xxxx.prod.aws.tidbcloud.com:4000/stock_portfolio?sslaccept=strict"

# Next.js Configuration
NODE_ENV=development
# JWT の署名鍵。`openssl rand -base64 32` の出力を貼る。
# 推測できる値のままだとセッションを偽造されるため、初期値では使わないこと。
# 変更すると既存のログイン状態はすべて無効になる。
NEXTAUTH_SECRET=your-nextauth-secret-key-change-this-in-production
# ローカル開発は 3300（pnpm dev のポート）。
# 本番では公開 URL（https://xxxxx.vercel.app）にする。NextAuth のコールバック先で
# あると同時に、ダッシュボードと資産推移の画面がサーバー側から自分の /api/* を
# 呼ぶときのベース URL でもあるため、誤ると画面が 500 になる。
NEXTAUTH_URL=http://localhost:3300

# 認証（Google OAuth / ADR 0011）
#
# 取得手順:
#   1. Google Cloud Console > APIとサービス > 認証情報
#   2. 「認証情報を作成」>「OAuth クライアント ID」
#   3. アプリケーションの種類: ウェブアプリケーション
#   4. 承認済みのリダイレクト URI に {NEXTAUTH_URL}/api/auth/callback/google を登録
#      （ローカルなら http://localhost:3300/api/auth/callback/google）
#      本番 URL ぶんも同じ画面に追加する。ローカル用しか登録していないとログインできない。

# 手順 3 で発行されるクライアント ID（xxxxx.apps.googleusercontent.com）
GOOGLE_CLIENT_ID=your-google-oauth-client-id
# 同じく発行されるクライアントシークレット（GOCSPX-xxxxx）
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# ログインを許可するメールアドレス。単一ユーザー運用のため 1 件のみ。
# 未設定の場合はすべてのログインを拒否する。
ALLOWED_LOGIN_EMAIL=you@example.com

# バッチ（/api/batch/*）
#
# 手動実行（POST）の認証キー。X-API-Key ヘッダーに同じ値を入れて叩く。
# ブラウザのセッションを持たない経路なので、middleware の保護対象から外れている。
BATCH_API_KEY=your-batch-api-key
# 日次終値バッチの定期実行（GET）の認証キー（ADR 0013）。
# Vercel のプロジェクト環境変数に設定すると、Vercel Cron が
# Authorization: Bearer <この値> を付けて呼び出す。16 文字以上のランダム文字列にする。
# 未設定だと GET は常に 401 を返す（設定漏れで誰でも叩ける状態にしないため）。
CRON_SECRET=your-cron-secret

# 株価データ API の乗り換え候補（未使用）
#
# 本アプリの価格取得は Yahoo Finance の非公式 API に依存しており、公式ドキュメントが
# 存在せず予告なく壊れうる。その乗り換え先の候補として名前だけ控えてある。
# 現在のコードはこの 2 つをどこからも読んでいないため、値を入れても何も変わらない。
# Vercel の環境変数に登録する必要も無い。検討状況は docs/external-apis.md を参照。

# Alpha Vantage（https://www.alphavantage.co/）。株式・為替を提供。API キー必須。
# ALPHA_VANTAGE_API_KEY=your_api_key
# Polygon（https://polygon.io/）。米国株・為替が中心。API キー必須。
# POLYGON_API_KEY=your_api_key
