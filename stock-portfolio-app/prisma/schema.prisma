// 株式ポートフォリオ管理アプリ - Prisma Schema
// TSVファイルベースのデータ構造に基づく設計

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// 銘柄マスタ（TSVファイルの全20列に対応）
model Stock {
  id               Int       @id @default(autoincrement())
  no               Int?      // TSVのNo列
  stockName        String    // 銘柄名
  holdingCompany   String    // 保有会社（証券会社）
  market           String    // 市場（国内/米国）
  code             String    @unique // コード

  // 保有・投資情報
  sharesHeld            Decimal  @default(0) @db.Decimal(15,4)  // 保有株数
  avgAcquisitionPrice   Decimal  @default(0) @db.Decimal(15,4)  // 平均取得単価
  investmentAmount      Decimal  @default(0) @db.Decimal(15,2)  // 投資額
  currentPrice          Decimal  @default(0) @db.Decimal(15,4)  // 現在価格
  profitLoss            Decimal  @default(0) @db.Decimal(15,2)  // 損益
  profitLossRate        Decimal  @default(0) @db.Decimal(8,4)   // 損益率

  // 配当情報
  dividendPerShare      Decimal  @default(0) @db.Decimal(10,4)  // 1株配当金
  dividendYield         Decimal  @default(0) @db.Decimal(8,4)   // 配当利回り
  dividendAmount        Decimal  @default(0) @db.Decimal(15,2)  // 配当金額

  // 取引情報
  purchaseDate          DateTime? // 購入日
  saleDate              DateTime? // 売却日
  realizedProfitLoss    Decimal? @db.Decimal(15,2) // 実現損益
  targetPrice           Decimal? @db.Decimal(15,4) // 目標価格
  marketSector          String?   // 市場・セクター
  purpose               String?   // 目的

  // 価格更新情報
  lastPriceUpdate       DateTime? // 最終価格更新日時
  priceUpdateStatus     PriceUpdateStatus @default(PENDING) // 更新ステータス
  priceUpdateError      String?   // 更新エラー内容
  priceSource           String?   // 価格取得元

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // リレーション
  transactions          Transaction[]
  dividendHistory       DividendHistory[]
  priceHistory          PriceHistory[]
}

// 為替レート（日次キャッシュ）
// 米国株の円換算に使う USD/JPY を 1 日 1 レコードで保存する。
// Yahoo Finance の USDJPY=X から取得し、rateDate（適用日）でユニーク。
model ExchangeRate {
  id        Int      @id @default(autoincrement())
  base      String   // 基軸通貨（例: USD）
  quote     String   // 相手通貨（例: JPY）
  rate      Decimal  @db.Decimal(15,6) // base 1 単位あたりの quote 額（例: 1 USD = 161.31 JPY）
  rateDate  DateTime @db.Date // レート適用日（サーバーローカルの暦日）
  source    String   // 取得元（yahoo）
  createdAt DateTime @default(now())

  @@unique([base, quote, rateDate])
}

// 価格履歴（新機能：価格取得機能のため）
model PriceHistory {
  id            Int       @id @default(autoincrement())
  stockId       Int
  price         Decimal   @db.Decimal(15,4)
  recordedAt    DateTime
  source        String    // yahoo, rakuten, manual
  marketSession MarketSession? // morning, afternoon, after_hours
  createdAt     DateTime  @default(now())

  stock         Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId, recordedAt])
}

// 取引履歴（売買のみ。配当は DividendHistory で管理 / ADR 0002）
model Transaction {
  id              Int             @id @default(autoincrement())
  stockId         Int
  transactionType TransactionType // BUY, SELL
  shares          Decimal         @db.Decimal(15,4)
  pricePerShare   Decimal         @db.Decimal(15,4)
  totalAmount     Decimal         @db.Decimal(15,2)
  fee             Decimal         @default(0) @db.Decimal(15,2)
  transactionDate DateTime
  memo            String?
  createdAt       DateTime        @default(now())

  stock           Stock           @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId, transactionDate])
}

// 配当履歴
model DividendHistory {
  id              Int       @id @default(autoincrement())
  stockId         Int
  dividendAmount  Decimal   @db.Decimal(15,2)  // 受取通貨（currency）建ての金額。集計時に当日レートで円換算する
  currency        String    @default("JPY")    // 受取通貨（JPY / USD）。米国株でも証券会社の円受取があるため銘柄の市場とは独立に持つ
  paymentDate     DateTime
  dividendType    String?   // 配当種別（期末/中間/四半期/特別/分配金）。表示専用ラベルで集計には使わないため任意（未指定=NULL 可）
  createdAt       DateTime  @default(now())

  stock           Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId, paymentDate])
}

// ポートフォリオサマリー（キャッシュ用）
model PortfolioSummary {
  id                    Int      @id @default(autoincrement())
  totalInvestment       Decimal  @db.Decimal(15,2)
  totalProfitLoss       Decimal  @db.Decimal(15,2)
  totalDividend         Decimal  @db.Decimal(15,2)
  totalProfitRate       Decimal  @db.Decimal(8,4)
  summaryDate           DateTime
  createdAt             DateTime @default(now())

  @@unique([summaryDate])
}

// 証券会社マスタ
model Broker {
  id        Int      @id @default(autoincrement())
  name      String   @unique // 証券会社名
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// アプリ設定（キー・バリュー形式）
// 例: key="allowTransactionEdit", value="true"/"false"
//   取引履歴の編集・削除を許可するかのフラグ。誤操作防止のため既定は無効。
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ENUM定義
enum TransactionType {
  BUY
  SELL
}

enum PriceUpdateStatus {
  SUCCESS
  ERROR
  PENDING
}

enum MarketSession {
  MORNING     // 前場
  AFTERNOON   // 後場
  AFTER_HOURS // 時間外
}
